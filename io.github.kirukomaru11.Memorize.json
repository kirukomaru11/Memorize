{
    "app-id" : "io.github.kirukomaru11.Memorize",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "master",
    "sdk" : "org.gnome.Sdk",
    "command" : "memorize",
    "finish-args" : [ "--device=dri", "--share=network", "--socket=pulseaudio", "--socket=wayland" ],
    "modules" : [
        {
            "name" : "fsrs",
            "buildsystem" : "simple",
            "build-commands" : [
                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"typing_extensions\" --no-build-isolation",
                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"fsrs\" --no-build-isolation"
            ],
            "sources" : [
                {
                  "type" : "file",
                  "url" : "https://files.pythonhosted.org/packages/49/d3/b8441a820a491ddfc024b0b0cf0393375b75ea13866d9c66727e54c2fc80/typing_extensions-4.16.0-py3-none-any.whl",
                  "sha256" : "481caa481374e813c1b176ada14e97f1f67a4539ce9cfeb3f350d78d6370c2e8"
                },
                {
                  "type" : "file",
                  "url" : "https://files.pythonhosted.org/packages/00/b9/c815e796480dd22441886f06b23f249a7ff2e3f41fc9bfaa428332e34b49/fsrs-6.3.2-py3-none-any.whl",
                  "sha256" : "bc55066c821164b1cff6d75b17a3ed8e86cfd45789e3d775cfcb895319ce9ba4"
                }
            ]
        },
        {
            "name" : "main",
            "buildsystem" : "simple",
            "build-commands" : [ "mv utils/* .", "env", "python ${FLATPAK_ID##*.}.py --install" ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/kirukomaru11/Memorize.git",
                    "branch" : "main"
                },
                {
                    "type" : "git",
                    "url" : "https://github.com/kirukomaru11/Utils.git",
                    "branch" : "main",
                    "dest" : "utils"
                }
            ]
        }
    ]
}